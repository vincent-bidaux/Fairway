{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fairway",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Vite build (SPA) runs before every deploy, including Workers Builds from GitHub.
  "build": { "command": "npm run build" },

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fairway-db",
      "database_id": "1f13304c-635c-43f0-b042-e0e7f0e5d99a",
      "migrations_dir": "db/migrations"
    }
  ],

  // Hourly: each run refreshes the sources that are due (oldest first, in batches).
  "triggers": { "crons": ["17 * * * *"] },

  "vars": {
    "ANTHROPIC_MODEL": "claude-haiku-5-5",
    "CRAWL_BATCH_SIZE": "8",
    "CRAWL_MIN_INTERVAL_HOURS": "20"
  },

  "observability": { "enabled": true }

  // Secrets (wrangler secret put …): ANTHROPIC_API_KEY, ADMIN_TOKEN
}
