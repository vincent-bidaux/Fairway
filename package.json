{
  "name": "fairway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fairway-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fairway-db --remote",
    "db:seed:local": "wrangler d1 execute fairway-db --local --file=./db/seed/golfs.sql",
    "db:seed:remote": "wrangler d1 execute fairway-db --remote --file=./db/seed/golfs.sql",
    "seed:build": "node ./scripts/build-seed.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^4.152.0"
  }
}
